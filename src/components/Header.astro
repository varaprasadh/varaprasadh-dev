---
const { activeNav, overlay = false } = Astro.props;

const navLinks = [
  { href: '/projects', label: 'Work', id: 'projects' },
  { href: '/blog', label: 'Writing', id: 'blog' },
  { href: '/about', label: 'About', id: 'about' },
];
---

<header class={`sticky top-0 z-50 border-b border-white/10 backdrop-blur-md ${overlay ? 'bg-dusk/25' : 'bg-dusk/95'}`}>
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-display text-xl text-sand font-bold tracking-tight">
      Varaprasadh
    </a>

    <nav class="hidden sm:flex items-center gap-8" aria-label="Primary">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm tracking-wide hover:text-ember ${
            activeNav === link.id ? 'text-ember' : 'text-sand/70'
          }`}
          aria-current={activeNav === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      id="menu-toggle"
      class="sm:hidden text-sand/80 hover:text-sand text-sm"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </div>

  <div id="mobile-menu" class="hidden sm:hidden border-t border-white/10 bg-dusk">
    <nav class="max-w-6xl mx-auto px-6 py-5 flex flex-col gap-4" aria-label="Mobile">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`font-display text-2xl hover:text-ember ${
            activeNav === link.id ? 'text-ember' : 'text-sand'
          }`}
          aria-current={activeNav === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const firstLink = menu?.querySelector('a');

  function setOpen(open) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
    if (open) firstLink?.focus();
    else toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
    }
  });
</script>
