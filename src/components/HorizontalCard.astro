---
const { title, desc, url, badge, target = "_blank" } = Astro.props;
---

<a
  href={url}
  target={target}
  class="group block py-4 border-b border-[#1a1a1a] hover:border-[#333333] transition-colors"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-3 mb-1">
        <span class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors">
          {title}
        </span>
        {badge && (
          <span class="text-[10px] border border-[#4ade80] text-[#4ade80] px-1.5 py-0.5 uppercase tracking-wider leading-none">
            {badge}
          </span>
        )}
      </div>
      <p class="text-xs text-[#555555] leading-relaxed">{desc}</p>
    </div>
    <span class="text-[#333333] group-hover:text-[#4ade80] transition-colors text-sm shrink-0 mt-0.5">
      →
    </span>
  </div>
</a>
