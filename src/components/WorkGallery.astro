---
import type { Project } from "../config";

export interface Props {
  items: Project[];
}

const { items } = Astro.props;

function badgeLabel(badge?: string) {
  if (!badge) return "";
  return badge.charAt(0).toUpperCase() + badge.slice(1).toLowerCase();
}
---

<ul class="space-y-16">
  {items.map((p) => (
    <li>
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group grid md:grid-cols-12 gap-6 md:gap-10 items-start"
      >
        {p.image ? (
          <div class="md:col-span-7 overflow-hidden bg-ridge aspect-[16/10]">
            <img
              src={p.image}
              alt=""
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
            />
          </div>
        ) : (
          <div class="md:col-span-7 aspect-[16/10] bg-dusk flex items-end p-6">
            <span class="font-display italic text-sand/40 text-4xl">{p.title}</span>
          </div>
        )}
        <div class="md:col-span-5 md:pt-4">
          {p.badge && (
            <p class="text-ember text-xs tracking-wide mb-3">{badgeLabel(p.badge)}</p>
          )}
          <h3 class="font-display text-3xl text-ink group-hover:text-ember transition-colors mb-3">
            {p.title}
          </h3>
          <p class="text-haze leading-relaxed">{p.desc}</p>
        </div>
      </a>
    </li>
  ))}
</ul>
