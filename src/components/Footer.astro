---
import { SOCIAL_LINKS } from "../config";
const today = new Date();
---

<footer class="max-w-5xl mx-auto px-6 py-12 border-t border-line mt-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <span class="text-mist text-sm">
      &copy; {today.getFullYear()} Varaprasadh Alajangi
    </span>
    <div class="flex items-center gap-6">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay text-sm">
        GitHub
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay text-sm">
        X
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay text-sm">
        LinkedIn
      </a>
    </div>
  </div>
</footer>
