---
import type { Project } from "../config";

export interface Props {
  items: Project[];
}

const { items } = Astro.props;

function badgeLabel(badge?: string) {
  if (!badge) return "";
  return badge.charAt(0).toUpperCase() + badge.slice(1).toLowerCase();
}
---

<ul>
  {items.map((p) => (
    <li class="border-t border-line first:border-t-0">
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block py-6"
      >
        <p class="font-display text-2xl sm:text-3xl text-ink group-hover:text-ember transition-colors">
          {p.title}
          {p.badge && (
            <span class="ml-3 font-sans text-xs tracking-wide font-normal text-ember align-middle">{badgeLabel(p.badge)}</span>
          )}
        </p>
        <p class="mt-2 text-haze max-w-xl leading-relaxed">{p.desc}</p>
      </a>
    </li>
  ))}
</ul>
