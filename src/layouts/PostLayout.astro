---
import { BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../lib/dates";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge } = Astro.props;
const displayDate = formatDate(pubDate);
---

<BaseLayout
  title={`${title} — varaprasadh.dev`}
  description={description}
  image={heroImage}
  activeNav="blog"
  ogType="article"
>
  <article>
    <p class="mb-10">
      <a href="/blog" class="text-sm text-mist hover:text-bay">
        Writing
      </a>
    </p>

    <header class="mb-12">
      <p class="text-sm text-mist mb-4">
        <time datetime={pubDate.toISOString()}>{displayDate}</time>
        {badge && <span class="text-laterite"> · {badge}</span>}
      </p>
      <h1 class="text-3xl sm:text-4xl text-ink leading-tight mb-4">
        {title}
      </h1>
      <p class="text-lg text-mist leading-relaxed">{description}</p>
      {updatedDate && (
        <p class="text-sm text-mist mt-3">Updated {updatedDate}</p>
      )}
    </header>

    {heroImage && (
      <img src={heroImage} alt="" class="w-full mb-12" />
    )}

    <div class="prose prose-read max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
