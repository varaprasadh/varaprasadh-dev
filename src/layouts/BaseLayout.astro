---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
  image?: string;
  title?: string;
  description?: string;
  activeNav?: string;
  ogType?: string;
  noindex?: boolean;
  flush?: boolean;
}

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  activeNav,
  ogType,
  noindex = false,
  flush = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} noindex={noindex} />
  </head>
  <body class="bg-sand text-ink min-h-screen font-sans">
    <div class="grain" aria-hidden="true"></div>
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:bg-sand focus:px-3 focus:py-2">
      Skip to content
    </a>
    <Header activeNav={activeNav} overlay={flush} />
    {flush ? (
      <div id="content">
        <slot />
      </div>
    ) : (
      <main id="content" class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
        <slot />
      </main>
    )}
    <Footer />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
