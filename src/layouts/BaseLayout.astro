---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
  image?: string;
  title?: string;
  description?: string;
  activeNav?: string;
  ogType?: string;
  noindex?: boolean;
  wide?: boolean;
}

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  activeNav,
  ogType,
  noindex = false,
  wide = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} noindex={noindex} />
  </head>
  <body class="bg-salt text-ink min-h-screen font-sans">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:bg-salt focus:px-3 focus:py-2">
      Skip to content
    </a>
    <Header activeNav={activeNav} />
    <main id="content" class={`mx-auto px-6 py-16 sm:py-20 ${wide ? "max-w-5xl" : "max-w-2xl"}`}>
      <slot />
    </main>
    <Footer />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
