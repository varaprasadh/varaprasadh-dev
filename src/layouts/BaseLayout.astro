---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
  image?: string;
  title?: string;
  description?: string;
  activeNav?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  activeNav,
  ogType,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} noindex={noindex} />
  </head>
  <body class="bg-[#0a0a0a] text-[#cccccc] min-h-screen font-mono">
    <Header activeNav={activeNav} />
    <main class="max-w-3xl mx-auto px-6 py-12">
      <slot />
    </main>
    <Footer />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
