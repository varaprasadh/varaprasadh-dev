---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkGallery from "../components/WorkGallery.astro";
import { PROFESSIONAL_PROJECTS, PERSONAL_PROJECTS } from "../config";
---

<BaseLayout title="Work — varaprasadh.dev" activeNav="projects" flush>
  <div class="bg-sand">
    <div class="max-w-6xl mx-auto px-6 pt-16 sm:pt-24 pb-12">
      <p class="text-ember text-sm tracking-[0.22em] mb-4">Work</p>
      <h1 class="font-display font-extrabold text-5xl sm:text-7xl tracking-tightest max-w-3xl">
        Logistics platforms, supply chains, a few experiments.
      </h1>
    </div>

    <div class="max-w-6xl mx-auto px-6 py-12">
      <h2 class="text-3xl mb-12">Professional</h2>
      <WorkGallery items={PROFESSIONAL_PROJECTS} />
    </div>

    <div class="max-w-6xl mx-auto px-6 py-12 pb-28">
      <h2 class="text-3xl mb-12">Personal</h2>
      <WorkGallery items={PERSONAL_PROJECTS} />
      <p class="pt-16">
        <a
          href="https://github.com/varaprasadh"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ember hover:underline underline-offset-4"
        >
          More on GitHub
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
