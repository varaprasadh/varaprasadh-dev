---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROFESSIONAL_PROJECTS, PERSONAL_PROJECTS } from "../config";
---

<BaseLayout title="Projects — varaprasadh.dev" activeNav="projects">
  <h1 class="sr-only">Projects</h1>
  <p class="text-[#4ade80] text-xs mb-8">$ ls ~/projects</p>

  <section class="mb-12">
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">professional</h2>
    {PROFESSIONAL_PROJECTS.map(p => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block py-4 border-b border-[#1a1a1a] hover:border-[#2a2a2a] transition-colors"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors">{p.title}</span>
              {p.badge && (
                <span class="text-[10px] border border-[#4ade80] text-[#4ade80] px-1.5 py-0.5 uppercase tracking-wider leading-none">
                  {p.badge}
                </span>
              )}
            </div>
            <p class="text-xs text-terminal-muted">{p.desc}</p>
          </div>
          <span class="text-terminal-muted group-hover:text-[#4ade80] transition-colors text-sm shrink-0 mt-0.5">→</span>
        </div>
      </a>
    ))}
  </section>

  <section>
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">personal</h2>
    {PERSONAL_PROJECTS.map(p => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block py-4 border-b border-[#1a1a1a] hover:border-[#2a2a2a] transition-colors"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors">{p.title}</span>
              {p.badge && (
                <span class="text-[10px] border border-[#4ade80] text-[#4ade80] px-1.5 py-0.5 uppercase tracking-wider leading-none">
                  {p.badge}
                </span>
              )}
            </div>
            <p class="text-xs text-terminal-muted">{p.desc}</p>
          </div>
          <span class="text-terminal-muted group-hover:text-[#4ade80] transition-colors text-sm shrink-0 mt-0.5">→</span>
        </div>
      </a>
    ))}

    <div class="pt-8">
      <a
        href="https://github.com/varaprasadh"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-terminal-muted hover:text-[#4ade80] transition-colors"
      >
        → more on github
      </a>
    </div>
  </section>
</BaseLayout>
