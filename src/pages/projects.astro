---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkList from "../components/WorkList.astro";
import { PROFESSIONAL_PROJECTS, PERSONAL_PROJECTS } from "../config";
---

<BaseLayout title="Work — varaprasadh.dev" activeNav="projects">
  <h1 class="text-4xl text-ink mb-4">Work</h1>
  <p class="text-lg text-mist mb-16 max-w-xl leading-relaxed">
    Logistics platforms, supply chain tools, and a few personal experiments.
  </p>

  <section class="mb-16">
    <h2 class="text-2xl text-ink mb-2">Professional</h2>
    <WorkList items={PROFESSIONAL_PROJECTS} />
  </section>

  <section>
    <h2 class="text-2xl text-ink mb-2">Personal</h2>
    <WorkList items={PERSONAL_PROJECTS} />
    <p class="pt-8">
      <a
        href="https://github.com/varaprasadh"
        target="_blank"
        rel="noopener noreferrer"
        class="text-bay hover:underline underline-offset-4"
      >
        More on GitHub
      </a>
    </p>
  </section>
</BaseLayout>
