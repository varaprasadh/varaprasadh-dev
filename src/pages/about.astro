---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../config";

const experience = [
  {
    title: "Associate Software Architect",
    company: "Imaginnovate",
    period: "2024 – now",
    desc: "Designing and reviewing strategic solutions across multiple enterprise projects.",
  },
  {
    title: "Tech Lead",
    company: "Imaginnovate",
    period: "2022 – 2023",
    desc: "Led development teams to streamline delivery and maintain engineering standards.",
  },
  {
    title: "Senior Software Engineer III",
    company: "Imaginnovate",
    period: "2021 – 2022",
    desc: "Delivered quality software across varied projects and technology stacks.",
  },
  {
    title: "Fullstack Engineer",
    company: "VSH Solutions",
    period: "2020 – 2021",
    desc: "Built full-stack applications with a solid, collaborative team.",
  },
];

const skills = [
  "Node.js", "React", "React Native", "Vue", "Next.js",
  "Spring Boot", "Python", "PostgreSQL", "MongoDB",
  "Google Cloud", "Docker", "CI/CD", "Electron",
  "Browser extensions", "Astro", "Linux", "Git", "AI toolkits",
];
---

<BaseLayout title="About — varaprasadh.dev" activeNav="about">
  <h1 class="text-4xl text-ink mb-8">About</h1>

  <section class="mb-16">
    <p class="text-lg text-ink leading-relaxed mb-4">
      I'm Varaprasadh — Vara, for short. I have been coding since college: web apps, mobile apps, browser extensions, and tools.
    </p>
    <p class="text-lg text-mist leading-relaxed">
      I work across the full lifecycle, from interface design to cloud deployment. Right now I am an associate software architect at
      <a href="https://www.imaginnovate.com/" target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">Imaginnovate</a>,
      building
      <a href="https://fleetenable.com/" target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">Fleetenable</a>
      — specifically Able, its AI engine.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl text-ink mb-8">Experience</h2>
    <ol class="space-y-8">
      {experience.map(e => (
        <li class="grid grid-cols-[6.5rem_1fr] gap-4">
          <span class="text-sm text-mist pt-1">{e.period}</span>
          <div>
            <p class="font-serif text-lg text-ink">{e.title}</p>
            <p class="text-bay text-sm mb-1">{e.company}</p>
            <p class="text-mist leading-relaxed">{e.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl text-ink mb-6">Skills</h2>
    <p class="text-mist leading-relaxed">
      {skills.join(', ')}
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl text-ink mb-6">Certifications</h2>
    <ul class="space-y-3">
      <li>
        <a
          href="https://www.credly.com/badges/8be11753-a2f8-4483-8c1d-7dc36de93a2e"
          target="_blank"
          rel="noopener noreferrer"
          class="text-bay hover:underline underline-offset-4"
        >
          Professional Google Cloud Architect
        </a>
      </li>
      <li class="text-mist">
        Professional Google Cloud Developer <span class="text-sm">(expired)</span>
      </li>
    </ul>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl text-ink mb-8">Education</h2>
    <ol class="space-y-8">
      <li class="grid grid-cols-[6.5rem_1fr] gap-4">
        <span class="text-sm text-mist pt-1">2017–2020</span>
        <div>
          <p class="font-serif text-lg text-ink">B.S. Computer Science Engineering</p>
          <p class="text-mist">ANITS, Vizag, India</p>
        </div>
      </li>
      <li class="grid grid-cols-[6.5rem_1fr] gap-4">
        <span class="text-sm text-mist pt-1">2014–2017</span>
        <div>
          <p class="font-serif text-lg text-ink">Diploma in Mechanical Engineering</p>
          <p class="text-mist">GPT, Srikakulam, India</p>
        </div>
      </li>
    </ol>
  </section>

  <section>
    <h2 class="text-2xl text-ink mb-6">Connect</h2>
    <div class="flex items-center gap-6">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">GitHub</a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">X</a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">LinkedIn</a>
    </div>
  </section>
</BaseLayout>
