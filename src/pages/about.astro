---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL_LINKS } from "../config";

const experience = [
  {
    title: "Associate Software Architect",
    company: "Imaginnovate",
    period: "2024 – now",
    desc: "Designing and reviewing strategic solutions across multiple enterprise projects.",
  },
  {
    title: "Tech Lead",
    company: "Imaginnovate",
    period: "2022 – 2023",
    desc: "Led development teams to streamline delivery and maintain engineering standards.",
  },
  {
    title: "Senior Software Engineer III",
    company: "Imaginnovate",
    period: "2021 – 2022",
    desc: "Delivered quality software across varied projects and technology stacks.",
  },
  {
    title: "Fullstack Engineer",
    company: "VSH Solutions",
    period: "2020 – 2021",
    desc: "Built full-stack applications with a solid, collaborative team.",
  },
];

const skills = [
  "NodeJS", "React", "React Native", "VueJS", "NextJS",
  "Spring Boot", "Python", "PostgreSQL", "MongoDB",
  "Google Cloud", "Docker", "CI/CD", "Electron",
  "Browser Extensions", "Astro", "Linux", "Git", "AI toolkits",
];
---

<BaseLayout title="About — varaprasadh.dev" activeNav="about">
  <h1 class="sr-only">About</h1>
  <p class="text-[#4ade80] text-xs mb-8">$ cat ~/about.md</p>

  <section class="mb-12">
    <p class="text-sm text-[#aaaaaa] leading-relaxed max-w-xl">
      this is varaprasadh — <span class="text-[#e8e8e8]">vara</span> in short.
      been coding since college. built web apps, mobile apps, browser extensions, and tools.
      comfortable across the full software lifecycle — from UI/UX design to cloud deployment.
      currently working as an associate software architect at
      <a href="https://www.imaginnovate.com/" target="_blank" rel="noopener noreferrer" class="text-[#4ade80] hover:underline">imaginnovate</a>,
      building <a href="https://fleetenable.com/" target="_blank" rel="noopener noreferrer" class="text-[#4ade80] hover:underline">fleetenable</a> — currently working on Able, its AI engine.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">experience</h2>
    <div class="space-y-6">
      {experience.map(e => (
        <div class="grid grid-cols-[5rem_1fr] gap-4">
          <span class="text-[10px] text-terminal-muted pt-0.5 whitespace-nowrap">{e.period}</span>
          <div>
            <p class="text-sm text-[#e8e8e8] mb-0.5">{e.title}</p>
            <p class="text-xs text-[#4ade80] mb-1">{e.company}</p>
            <p class="text-xs text-terminal-muted leading-relaxed">{e.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">skills</h2>
    <p class="text-xs text-terminal-muted leading-relaxed">
      {skills.join(' · ')}
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">certifications</h2>
    <div class="space-y-3">
      <div>
        <a
          href="https://www.credly.com/badges/8be11753-a2f8-4483-8c1d-7dc36de93a2e"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[#e8e8e8] hover:text-[#4ade80] transition-colors"
        >
          Professional Google Cloud Architect →
        </a>
      </div>
      <div>
        <span class="text-sm text-terminal-muted">
          Professional Google Cloud Developer <span class="text-[10px] border border-[#333333] text-terminal-muted px-1 py-0.5 uppercase tracking-wider">expired</span>
        </span>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">education</h2>
    <div class="space-y-6">
      <div class="grid grid-cols-[5rem_1fr] gap-4">
        <span class="text-[10px] text-terminal-muted pt-0.5">2017–2020</span>
        <div>
          <p class="text-sm text-[#e8e8e8] mb-0.5">B.S. Computer Science Engineering</p>
          <p class="text-xs text-terminal-muted">ANITS, Vizag, India</p>
        </div>
      </div>
      <div class="grid grid-cols-[5rem_1fr] gap-4">
        <span class="text-[10px] text-terminal-muted pt-0.5">2014–2017</span>
        <div>
          <p class="text-sm text-[#e8e8e8] mb-0.5">Diploma in Mechanical Engineering</p>
          <p class="text-xs text-terminal-muted">GPT, Srikakulam, India</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-xs text-terminal-muted uppercase tracking-widest mb-6">connect</h2>
    <div class="flex items-center gap-6">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"
        class="text-xs text-terminal-muted hover:text-[#4ade80] transition-colors">
        github →
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer"
        class="text-xs text-terminal-muted hover:text-[#4ade80] transition-colors">
        x/twitter →
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"
        class="text-xs text-terminal-muted hover:text-[#4ade80] transition-colors">
        linkedin →
      </a>
    </div>
  </section>
</BaseLayout>
