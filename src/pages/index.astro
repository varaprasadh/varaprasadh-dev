---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkList from "../components/WorkList.astro";
import { getCollection } from "astro:content";
import { SOCIAL_LINKS, PROFESSIONAL_PROJECTS } from "../config";
import { formatDate } from "../lib/dates";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const last_posts = posts.slice(0, 3);
const projects = PROFESSIONAL_PROJECTS.slice(0, 3);
---

<BaseLayout wide>
  <section class="max-w-2xl">
    <h1 class="text-4xl sm:text-5xl text-ink mb-6">
      Varaprasadh Alajangi
    </h1>
    <p class="text-xl text-mist leading-relaxed mb-6">
      Associate software architect in Vizag. I design and ship logistics systems, from the interface down to the cloud.
    </p>
    <p class="text-lg text-ink/90 leading-relaxed mb-10">
      These days I am building Able, the AI engine inside
      <a href="https://fleetenable.com/" target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">Fleetenable</a>,
      at
      <a href="https://www.imaginnovate.com/" target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">Imaginnovate</a>.
    </p>
    <div class="flex items-center gap-6 text-sm">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay">GitHub</a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay">X</a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-mist hover:text-bay">LinkedIn</a>
    </div>
  </section>

  <section class="grid md:grid-cols-2 gap-16 md:gap-20 mt-24">
    <div>
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-2xl text-ink">Work</h2>
        <a href="/projects" class="text-sm text-mist hover:text-bay">All work</a>
      </div>
      <WorkList items={projects} />
    </div>

    <div>
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-2xl text-ink">Writing</h2>
        <a href="/blog" class="text-sm text-mist hover:text-bay">All writing</a>
      </div>
      <ul>
        {last_posts.map(post => (
          <li class="border-t border-line first:border-t-0">
            <a href={`/blog/${post.slug}`} class="group block py-5">
              <p class="font-serif text-lg text-ink group-hover:text-bay">{post.data.title}</p>
              <p class="mt-1 text-mist text-[0.95rem] leading-relaxed">{post.data.description}</p>
              <time class="mt-2 block text-sm text-mist" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate, "MMMM YYYY")}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mt-24 max-w-2xl">
    <h2 class="text-2xl text-ink mb-4">Sparkly</h2>
    <p class="text-mist leading-relaxed mb-3">
      A Chrome new tab with universal search across tabs, history, and the web, plus Google Workspace, a tab manager, and a launchpad.
    </p>
    <a href="https://sparklytab.dev" target="_blank" rel="noopener noreferrer" class="text-bay hover:underline underline-offset-4">
      sparklytab.dev
    </a>
  </section>
</BaseLayout>
