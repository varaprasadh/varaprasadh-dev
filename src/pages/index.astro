---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SOCIAL_LINKS } from "../config";
import dayjs from "dayjs";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const last_posts = posts.slice(0, 3);

const projects = [
  {
    title: "PGT Services",
    desc: "Built the platform from foundation — load board, rating, BOL generation.",
    url: "https://www.pgt-services.com/",
    badge: "ONGOING",
  },
  {
    title: "Uber Freight × Transplace",
    desc: "Logistics solutions for managing supply chain and transportation.",
    url: "https://www.uberfreight.com/",
    badge: "ONGOING",
  },
  {
    title: "Leverage",
    desc: "Automated end-to-end supply chain visibility across POs, shipments, and inventory.",
    url: "https://www.tryleverage.ai/",
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="mb-16">
    <p class="text-[#4ade80] text-xs mb-4">$ whoami</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-[#e8e8e8] mb-2 cursor">
      varaprasadh alajangi
    </h1>
    <p class="text-sm text-[#888888] mb-6">
      associate software architect · vizag, india
    </p>
    <p class="text-sm text-[#aaaaaa] leading-relaxed max-w-xl mb-8">
      building enterprise systems from design to deployment.
      currently at <a href="https://www.imaginnovate.com/" target="_blank" class="text-[#4ade80] hover:underline">imaginnovate</a>.
      full-stack engineer with a focus on logistics, supply chain, and scalable platforms.
    </p>

    <!-- Social links -->
    <div class="flex items-center gap-6">
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"
        class="text-xs text-[#555555] hover:text-[#4ade80] transition-colors">
        github
      </a>
      <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer"
        class="text-xs text-[#555555] hover:text-[#4ade80] transition-colors">
        x/twitter
      </a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"
        class="text-xs text-[#555555] hover:text-[#4ade80] transition-colors">
        linkedin
      </a>
    </div>
  </section>

  <!-- Recent Work -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-[#4ade80] text-xs">~/projects</span>
      <div class="flex-1 border-t border-[#1a1a1a]"></div>
      <a href="/projects" class="text-[#333333] hover:text-[#4ade80] text-xs transition-colors">see all →</a>
    </div>

    {projects.map(p => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group block py-4 border-b border-[#1a1a1a] hover:border-[#2a2a2a] transition-colors"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <span class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors">{p.title}</span>
              {p.badge && (
                <span class="text-[10px] border border-[#4ade80] text-[#4ade80] px-1.5 py-0.5 uppercase tracking-wider leading-none">
                  {p.badge}
                </span>
              )}
            </div>
            <p class="text-xs text-[#555555]">{p.desc}</p>
          </div>
          <span class="text-[#333333] group-hover:text-[#4ade80] transition-colors text-sm shrink-0 mt-0.5">→</span>
        </div>
      </a>
    ))}
  </section>

  <!-- Latest Posts -->
  <section>
    <div class="flex items-center gap-3 mb-6">
      <span class="text-[#4ade80] text-xs">~/blog</span>
      <div class="flex-1 border-t border-[#1a1a1a]"></div>
      <a href="/blog" class="text-[#333333] hover:text-[#4ade80] text-xs transition-colors">see all →</a>
    </div>

    {last_posts.map(post => (
      <a
        href={`/blog/${post.slug}`}
        class="group block py-4 border-b border-[#1a1a1a] hover:border-[#2a2a2a] transition-colors"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors mb-1">
              {post.data.title}
            </p>
            <p class="text-xs text-[#555555]">{post.data.description}</p>
          </div>
          <span class="text-[#444444] text-xs shrink-0 whitespace-nowrap mt-0.5">
            {dayjs(post.data.pubDate).format("MMM YYYY")}
          </span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
