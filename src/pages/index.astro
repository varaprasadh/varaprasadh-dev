---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkList from "../components/WorkList.astro";
import { getCollection } from "astro:content";
import { SOCIAL_LINKS, PROFESSIONAL_PROJECTS } from "../config";
import { formatDate } from "../lib/dates";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const last_posts = posts.slice(0, 3);
const projects = PROFESSIONAL_PROJECTS.slice(0, 3);
---

<BaseLayout flush>
  <section class="relative min-h-[100svh] bg-dusk">
    <img
      src="/profile-hero.jpg"
      alt="Varaprasadh on a mountain ridge at sunset"
      class="absolute inset-0 w-full h-full object-cover object-[70%_40%]"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dusk via-dusk/25 to-dusk/30"></div>
    <div class="relative z-10 min-h-[100svh] flex flex-col justify-end max-w-6xl mx-auto px-6 pb-16 sm:pb-20 pt-28">
      <div class="hero-rise max-w-3xl">
        <p class="text-ember text-sm tracking-[0.22em] mb-5">17.7°N · 83.2°E</p>
        <h1 class="font-display text-sand font-extrabold tracking-tightest text-[clamp(3.2rem,11vw,8.5rem)] leading-[0.86]">
          Varaprasadh
          <span class="block font-medium">Alajangi</span>
        </h1>
        <p class="mt-8 text-sand/80 text-lg sm:text-xl max-w-md leading-relaxed font-light">
          Associate software architect in Vizag. I design and ship logistics systems, from the interface down to the cloud.
        </p>
        <div class="mt-8 flex gap-6 text-sm text-sand/60">
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="hover:text-ember">GitHub</a>
          <a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-ember">X</a>
          <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ember">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <main class="bg-sand">
    <div class="max-w-6xl mx-auto px-6 py-24 sm:py-32 grid md:grid-cols-2 gap-20">
      <section>
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="text-4xl">Work</h2>
          <a href="/projects" class="text-sm text-haze hover:text-ember">All work</a>
        </div>
        <WorkList items={projects} />
      </section>

      <section>
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="text-4xl">Writing</h2>
          <a href="/blog" class="text-sm text-haze hover:text-ember">All writing</a>
        </div>
        <ul>
          {last_posts.map(post => (
            <li class="border-t border-line first:border-t-0">
              <a href={`/blog/${post.slug}`} class="group block py-6">
                <p class="font-display text-2xl text-ink group-hover:text-ember transition-colors">{post.data.title}</p>
                <p class="mt-2 text-haze leading-relaxed">{post.data.description}</p>
                <time class="mt-3 block text-sm text-haze" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate, "MMMM YYYY")}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="max-w-6xl mx-auto px-6 pb-28">
      <p class="text-ember text-sm tracking-[0.22em] mb-4">Personal</p>
      <h2 class="font-display text-5xl sm:text-6xl font-extrabold mb-6">Sparkly</h2>
      <p class="text-haze text-lg max-w-xl leading-relaxed mb-6">
        A Chrome new tab with universal search across tabs, history, and the web — plus Google Workspace, a tab manager, and a launchpad.
      </p>
      <a href="https://sparklytab.dev" target="_blank" rel="noopener noreferrer" class="text-ember hover:underline underline-offset-4">
        sparklytab.dev
      </a>
    </section>
  </main>
</BaseLayout>
