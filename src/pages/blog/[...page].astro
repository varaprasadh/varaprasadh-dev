---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../lib/dates";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Writing — varaprasadh.dev" activeNav="blog">
  <p class="text-ember text-sm tracking-[0.22em] mb-4">Writing</p>
  <h1 class="font-display font-extrabold text-5xl sm:text-6xl tracking-tightest mb-6">
    Notes on tools and systems.
  </h1>
  <p class="text-lg text-haze mb-16 leading-relaxed">
    How I work, what I learn, what I keep.
  </p>

  {page.data.length === 0 ? (
    <p class="text-haze">No posts yet.</p>
  ) : (
    <ul>
      {page.data.map(post => (
        <li class="border-t border-line">
          <a href={`/blog/${post.slug}`} class="group block py-8">
            <p class="font-display text-2xl sm:text-3xl text-ink group-hover:text-ember transition-colors">{post.data.title}</p>
            <p class="mt-3 text-haze leading-relaxed">{post.data.description}</p>
            <time class="mt-3 block text-sm text-haze" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate, "MMMM D, YYYY")}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}

  <div class="flex justify-between mt-12 text-sm">
    {page.url.prev ? (
      <a href={page.url.prev} class="text-ember hover:underline underline-offset-4">
        Newer
      </a>
    ) : <span />}
    {page.url.next ? (
      <a href={page.url.next} class="text-ember hover:underline underline-offset-4">
        Older
      </a>
    ) : <span />}
  </div>
</BaseLayout>
