---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog — varaprasadh.dev" activeNav="blog">
  <p class="text-[#4ade80] text-xs mb-8">$ ls ~/blog</p>

  {page.data.length === 0 ? (
    <p class="text-sm text-[#555555]">no posts yet. check back later.</p>
  ) : (
    <div>
      {page.data.map(post => (
        <a
          href={`/blog/${post.slug}`}
          class="group block py-4 border-b border-[#1a1a1a] hover:border-[#2a2a2a] transition-colors"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm text-[#e8e8e8] group-hover:text-[#4ade80] transition-colors mb-1">
                {post.data.title}
              </p>
              <p class="text-xs text-[#555555] leading-relaxed">{post.data.description}</p>
            </div>
            <span class="text-[#444444] text-xs shrink-0 whitespace-nowrap mt-0.5">
              {dayjs(post.data.pubDate).format("MMM YYYY")}
            </span>
          </div>
        </a>
      ))}
    </div>
  )}

  <!-- Pagination -->
  <div class="flex justify-between mt-10">
    {page.url.prev ? (
      <a href={page.url.prev} class="text-xs text-[#555555] hover:text-[#4ade80] transition-colors">
        ← newer
      </a>
    ) : <span />}
    {page.url.next ? (
      <a href={page.url.next} class="text-xs text-[#555555] hover:text-[#4ade80] transition-colors">
        older →
      </a>
    ) : <span />}
  </div>
</BaseLayout>
