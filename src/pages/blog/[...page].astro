---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../../lib/dates";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Writing — varaprasadh.dev" activeNav="blog">
  <h1 class="text-4xl text-ink mb-4">Writing</h1>
  <p class="text-lg text-mist mb-12 leading-relaxed">
    Notes on tools, systems, and how I work.
  </p>

  {page.data.length === 0 ? (
    <p class="text-mist">No posts yet.</p>
  ) : (
    <ul>
      {page.data.map(post => (
        <li class="border-t border-line">
          <a href={`/blog/${post.slug}`} class="group block py-6">
            <p class="font-serif text-xl text-ink group-hover:text-bay">{post.data.title}</p>
            <p class="mt-2 text-mist leading-relaxed">{post.data.description}</p>
            <time class="mt-2 block text-sm text-mist" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate, "MMMM D, YYYY")}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}

  <div class="flex justify-between mt-12 text-sm">
    {page.url.prev ? (
      <a href={page.url.prev} class="text-bay hover:underline underline-offset-4">
        Newer
      </a>
    ) : <span />}
    {page.url.next ? (
      <a href={page.url.next} class="text-bay hover:underline underline-offset-4">
        Older
      </a>
    ) : <span />}
  </div>
</BaseLayout>
