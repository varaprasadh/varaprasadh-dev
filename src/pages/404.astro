---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" description="This page could not be found." noindex>
  <div class="text-center">
    <p class="text-9xl font-bold mb-2" aria-hidden="true">404</p>
    <h1 class="text-2xl mb-2">Page not found</h1>
    <p class="text-terminal-muted">The page you're looking for couldn't be found.</p>
    <a
      class="inline-block mt-9 text-sm border border-[#4ade80] text-[#4ade80] px-4 py-2 hover:bg-[#4ade80] hover:text-[#0a0a0a] transition-colors"
      href="/"
    >
      Let's Go Home
    </a>
  </div>
</BaseLayout>
